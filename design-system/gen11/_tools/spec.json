{
  "av": {
    "page": "dealer/all-vehicles-gen11.html",
    "title": "All Vehicles",
    "role": "the operational list — the densest surface in the product",
    "css": [
      "dealer/all-vehicles-gen11.css"
    ],
    "groups": [
      {
        "group": "Global chrome",
        "items": [
          {
            "name": "Platform bar",
            "role": "the object every page opens with",
            "sel": ".top",
            "note": "56px, 16px gutter, glass with one shadow. The AAN mark, the wordmark, the environment word, the destinations, then the utilities, then who you are."
          },
          {
            "name": "Navigation item",
            "role": "a destination",
            "sel": ".nav__it",
            "idx": 1,
            "note": "Brand-blue label. The current section carries a soft brand surface; hover carries the well. Adjacent items never touch — see the separation contract in RULES.md."
          },
          {
            "name": "Global search",
            "role": "search anywhere",
            "sel": ".gsearch",
            "note": "The elastic member of the header. When eight destinations do not fit, the width comes out of here, never out of the gap between controls."
          },
          {
            "name": "Utility button",
            "role": "icon-only header action",
            "sel": ".tbtn",
            "idx": 2,
            "note": "36px square, the same radius as the buttons beside it. Index 2 is Notifications; index 0 is the theme toggle, which every Gen 11 page ships with `hidden` and the title \"Dark theme is being re-solved\". A control that ships hidden on all ten pages is not shipped UI, so the catalogue shows one of the two that are."
          },
          {
            "name": "Dealer identity",
            "role": "which dealer you are acting for",
            "sel": ".dealer"
          },
          {
            "name": "Page head",
            "role": "title, context, page actions",
            "sel": ".head"
          }
        ]
      },
      {
        "group": "Actions",
        "items": [
          {
            "name": "Primary",
            "role": "the one committing action in a group",
            "sel": ".head .btn--primary",
            "note": "Brand fill, restrained glow. One per group — never two."
          },
          {
            "name": "Sheet",
            "role": "a neutral action that carries a surface",
            "sel": ".head .btn--sheet"
          },
          {
            "name": "Quiet",
            "role": "an action that sits on the ground",
            "sel": ".head .btn--quiet"
          },
          {
            "name": "Row action cluster",
            "role": "per-record icon actions",
            "sel": "#tb .row .acts",
            "note": "The dense tier. Icon-only, 27px, inside the Actions column of a table row."
          }
        ]
      },
      {
        "group": "Navigation and scope",
        "items": [
          {
            "name": "Lane strip",
            "role": "which slice of the list am I in",
            "sel": ".lanes",
            "note": "A joined segmented strip attached to the top of the workspace. One hairline around it, dividers between, the current lane on a brand rule."
          },
          {
            "name": "Facet",
            "role": "a filter with a current value",
            "sel": ".sub .facet",
            "idx": 0
          },
          {
            "name": "View switch",
            "role": "rows, gallery or photos",
            "sel": ".seg"
          },
          {
            "name": "Sub bar",
            "role": "scope line plus the filter row",
            "sel": ".sub"
          }
        ]
      },
      {
        "group": "Command",
        "items": [
          {
            "name": "Command band",
            "role": "the sticky search and sort layer",
            "sel": ".cmd"
          },
          {
            "name": "Search field",
            "role": "find a vehicle",
            "sel": ".cmd .search"
          }
        ]
      },
      {
        "group": "Table",
        "items": [
          {
            "name": "Column header",
            "role": "the sticky header row",
            "sel": ".hd"
          },
          {
            "name": "Row",
            "role": "one vehicle",
            "sel": "#tb .row",
            "idx": 1
          },
          {
            "name": "Stock cell",
            "role": "the identifier a dealer searches on",
            "sel": "#tb .row .stk",
            "idx": 1
          },
          {
            "name": "Price cell",
            "role": "money, with its discount history",
            "sel": "#tb .row .price",
            "idx": 1
          },
          {
            "name": "Status chip",
            "role": "lot status",
            "sel": "#tb .row .st",
            "idx": 1
          },
          {
            "name": "Health tags",
            "role": "the exceptions on a vehicle",
            "sel": "#tb .row .tags",
            "idx": 0
          },
          {
            "name": "Age",
            "role": "days in stock, as a bar and a figure",
            "sel": "#tb .row .age",
            "idx": 1
          },
          {
            "name": "Checkbox cell",
            "role": "bulk selection",
            "sel": "#tb .row .ck",
            "idx": 1
          },
          {
            "name": "Footer",
            "role": "count and pagination",
            "sel": ".foot"
          }
        ]
      },
      {
        "group": "Surfaces",
        "items": [
          {
            "name": "Bento",
            "role": "the lot at a glance",
            "sel": ".bento"
          },
          {
            "name": "Dark focal panel",
            "role": "the dominant summary object",
            "sel": ".focal"
          },
          {
            "name": "Attention queue",
            "role": "the exceptions, ranked",
            "sel": ".attn"
          },
          {
            "name": "Workspace",
            "role": "the sheet the list lives on",
            "sel": ".field"
          }
        ]
      }
    ]
  },
  "lead": {
    "page": "dealer/single-lead-gen11.html",
    "title": "Single Lead",
    "role": "a record read top to bottom — continuous sections, no tabs",
    "css": [
      "dealer/all-vehicles-gen11.css",
      "dealer/single-lead-gen11.css"
    ],
    "groups": [
      {
        "group": "Record chrome",
        "items": [
          {
            "name": "Record head",
            "role": "who this lead is",
            "sel": ".head"
          },
          {
            "name": "Section tabs",
            "role": "jump to a section — the page stays continuous",
            "sel": ".secnav",
            "note": "A segmented control, not a tab bar: it scrolls the page, it does not swap panels. Members sit 6px apart so four bordered boxes read as four choices."
          },
          {
            "name": "Section bar",
            "role": "the sticky bar the tabs live in",
            "sel": ".cmd.cmd--sec"
          }
        ]
      },
      {
        "group": "Record surfaces",
        "items": [
          {
            "name": "Bento",
            "role": "enquiry, activity and facts",
            "sel": ".bento"
          },
          {
            "name": "Vehicle card",
            "role": "the vehicle this enquiry is about",
            "sel": ".vcar"
          },
          {
            "name": "Workflow dock",
            "role": "state, assignment, follow-up, flags",
            "sel": ".dock"
          }
        ]
      },
      {
        "group": "Forms",
        "items": [
          {
            "name": "Field",
            "role": "label over control",
            "sel": ".f",
            "idx": 0
          },
          {
            "name": "Field grid",
            "role": "how fields sit next to each other",
            "sel": ".grid",
            "idx": 0
          }
        ]
      },
      {
        "group": "Activity",
        "items": [
          {
            "name": "Event",
            "role": "one entry in the feed",
            "sel": ".ev",
            "idx": 0,
            "note": "Meta line and body are 8px apart; entries are 16px apart. A 2:1 step is what lets the eye find where one note ends."
          },
          {
            "name": "Event kind",
            "role": "what sort of entry this is",
            "sel": ".kind",
            "idx": 0
          }
        ]
      }
    ]
  },
